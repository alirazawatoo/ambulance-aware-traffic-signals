# Settings read by smart-traffic-backend/main.py (pass with `docker run --env-file .env`).

# 1 = simulation: no weights, no Ultralytics; every frame "contains" an ambulance.
# Leave unset or 0 to load smart-traffic-backend/weights/best.pt with Ultralytics.
ITCS_USE_DUMMY_MODEL=1

# Comma-separated browser origins allowed by CORS. "*" allows any origin.
ITCS_CORS_ORIGINS=*
